// #1: comences molt baix i amb un sol sinte, a pitch -36 (o inclus -48).  Despres afegeixes un segon sinte igual al que li poses pitch de -12, i varies manualment a -7 o -9  etc. Sona un per barra. Un altre rescurs es cambiar de sample de marimba_pan a sitar_fsynth o a guitar_cow per una barra.
low > source marimba_panflute_c loop 8 //sitar_fsynth_c /guitar_cow_f
ch 8 7 6 5 4 3 2 1  ch_glide 2 
pitch -36
delay 1 dt 100 10 400 
gain 0.4

low_2 > source marimba_panflute_c loop 8 //sitar_fsynth_c /guitar_cow_f
ch 1 2 3 4 5 6 7 8 ch_glide 2 
pitch -36
delay 1 dt 400 600 200 dt_glide 0.4
gain 0.4

// Un cop porta una estona sonant low_1 i low_2, afegeixes low 3 que te molts mes aguts etc. I el deixes sonar tmb per una estona, es menja els altres dos pq satura els aguts..
low_3 > source sitar_fsynth_c loop 8 //sitar_fsynth_c /guitar_cow_f
ch 1 2 3 4 5 6 7 8 ch_glide 2 
pitch 0 // pitch 5 12 7 rotate 1
delay 1 dt 400 600 200 dt_glide 0.4
gain 0.4

//#2 Crackle layer: En el moment algit afegeixes aquesta textura de fons. Ja es quedará tot el set de fons, per no tenir silencis. Es fica un sol instance per barra q va repetint.
cr > source crackle loop 10
ch (1 2 3 4 5 6 7 8)
len 11



////#3 DRUMS: Per sobre la melodia, he posat aquests drums, brillen molt amb so espacialitzat pero amb estereo crec que sin mas realment… 
drums > source hat loop 4 
ch 1 2 3 4 5 6 7 8 rotate 2 ch_glide 0.1 
delay 1 dt 200 10 100 rotate 1
delay 0.5 dt 130
pitch -5
gain 1


////#4 SOROLLETS 
//sorollets
high > source violin_e_guitar_f loop 8  //anar pujant len i pitch uniforme a -12
ch 1 2 3 4 5 6 7 8 ch_glide 2
begin 1 1.3 1.5 2 0.7 rotate 1 len .2
pitch 24 12 19 rotate -1 // canvies el pitch central de 12 a -12, despres pots acabar amb algo como aixo “pitch -24 -12 -12 rotate -1”
lpf 10000
gain 0.8
delay 0.5 dt 250
delay 0.5 dt 248 250 252
delay 1 dt 1000  950 1150 dt_glide 0.1 dfb .8



////#5 Jugar a tenir varios acco, overlaid, copy paste i anar afegint-ne, modificar synth etc.
acco > source bass_chorous_guitar_c loop 16  //bass_chorous_guitar_c //accordion_e_guitar_c 
ch (2 3 4 5) (6 7 8 1) rotate 1 ch_glide 2
pitch 0 -5 rotate 1
delay .5 dt 1000 dfb 0.88
